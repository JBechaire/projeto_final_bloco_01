import { Produto } from "../model/Produto";
import { ProdutoRepository } from "../repository/ProdutoRepository";

export class ProdutoController implements ProdutoRepository {

    private listaProdutos: Array<Produto> = new Array<Produto>();
    id: number = 0;

    cadastrar(produto: Produto): void {
        this.listaProdutos.push(produto);
        console.log("\nO Chaveiro" + this.id + " foi cadastrado com sucesso!");
    }

    listarTodos(): void {
        for (let produto of this.listaProdutos){
            produto.visualizar();
        }
    }

    buscarPorId(id: number): void {
        let buscaLivro = this.buscarNoArray(id);

        if (buscaLivro != null) {
            buscaLivro.visualizar();
        } else {
            console.log("\nO Chaveiro não foi encontrado!");
        }
    }

    atualizar(produto: Produto): void {
        let buscaProdutoAntigo = this.buscarNoArray(produto.id);
        
        if (buscaProdutoAntigo !== null) {
        let index = this.listaProdutos.indexOf(buscaProdutoAntigo);

        this.listaProdutos[index] = produto;
        
        console.log("\nO Livro " + produto.id + "-" + produto.nome + " foi atualizado com sucesso!");
        } else {
        console.log("\nO Livro" + produto.id + "não foi encontrado!");
    }

    }

    deletar(id: number): void {
        let buscaLivro = this.buscarNoArray(id);

        if (buscaLivro != null) {
            this.listaProdutos.splice(this.listaProdutos.indexOf(buscaLivro), 1);
            console.log("\nO Livro: " + id + " foi apagado com sucesso!");
        } else 
            console.log("\nO livro número: " + id + " não foi encontrado!");
    }

    public gerarId(): number {
        return ++ this.id;
    }

    public buscarNoArray(id: number): Produto | null {
        for (let produto of this.listaProdutos) {
            if (produto.id === id) {
            return produto; 
            }
        }
        return null;